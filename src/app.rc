#include <windows.h>
#pragma code_page(65001)
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "080404b0"
  BEGIN
   VALUE "CompanyName", "drizzletown\0"
   VALUE "FileDescription", "磁盘文件整理助手\0"
   VALUE "ProductName", "磁盘文件整理助手\0"
   VALUE "OriginalFilename", "磁盘文件整理助手.exe\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x804, 1200
 END
END

1 RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/app.manifest"
